# =============================================================================
# WHATSAPP (WAHA) — sample environment (copy to .env.waha and fill in secrets)
# =============================================================================
# cp .env.sample.waha .env.waha
# https://waha.devlike.pro/docs/how-to/config/
# Docker: docker compose -f composefiles/waha-compose.yml up -d

# ── Python client (modules/wa_util.py) ───────────────────────────────────────
WAHA_API_URL=http://localhost:3001
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_DEFAULT_COUNTRY_CODE=91
WAHA_API_KEY=change-me-generate-a-long-random-key
# Receiver app: same secret you set in configure_webhooks(hmac_key=...)
# WAHA_WEBHOOK_HMAC_KEY=change-me-webhook-hmac-secret

# ── WAHA container security ─────────────────────────────────────────────────
# Must match WAHA_API_KEY above when using X-Api-Key on the API
# WAHA_API_KEY is read by the WAHA image as well — keep both in sync
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-dashboard-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me-swagger-password
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

# ── Engine ──────────────────────────────────────────────────────────────────
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
# WAHA_CLIENT_DEVICE_NAME=YourApp

# ── Session ─────────────────────────────────────────────────────────────────
WHATSAPP_START_SESSION=default
WHATSAPP_RESTART_ALL_SESSIONS=True

# ── Webhooks (global — optional; prefer session webhooks via WhatsAppUtil) ───
# WHATSAPP_HOOK_URL=https://your-app.com/webhooks/waha
# WHATSAPP_HOOK_HMAC_KEY=change-me-webhook-hmac-secret
# WHATSAPP_HOOK_EVENTS=session.status,message
# WHATSAPP_HOOK_CUSTOM_HEADERS=custom_header_key:custom_header_value

# ── Proxy ───────────────────────────────────────────────────────────────────
# WHATSAPP_PROXY_SERVER=proxy.example.com:3128
# WHATSAPP_PROXY_SERVER_USERNAME=user
# WHATSAPP_PROXY_SERVER_PASSWORD=pass

# ── Media storage (paths inside container; host: ./waha/media) ───────────────
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media
# WHATSAPP_DOWNLOAD_MEDIA=true
# WHATSAPP_FILES_MIMETYPES=image/jpeg,image/png

# ── Session storage (host: ./waha/sessions mounted to /app/.sessions) ─────
# Comment volume in compose if using MongoDB/Postgres instead:
# WHATSAPP_SESSIONS_POSTGRESQL_URL=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable
# WHATSAPP_SESSIONS_MONGO_URL=mongodb://user:pass@host:27017/waha

# ── Logging ─────────────────────────────────────────────────────────────────
WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=True

# ── Apps ────────────────────────────────────────────────────────────────────
# WAHA_APPS_ENABLED=True
# REDIS_URL=redis://:password@redis:6379

# ── Timezone ────────────────────────────────────────────────────────────────
# TZ=Asia/Kolkata
