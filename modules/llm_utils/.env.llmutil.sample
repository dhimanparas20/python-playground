# Sample env for llm_utils. Copy to .env in the folder you run from:
#   cp .env.llmutil.sample .env
# Fill only what you use. Blank values are ignored (they never wipe a real key).
# Every setting here is optional — each one is a fallback for the matching argument.

# =============================================================================
# Shared
# =============================================================================
DEFAULT_PROVIDER=opencode-go
# openai | anthropic | google | groq | openrouter | vercel | opencode | opencode-go
# or any custom name (see CUSTOM EXAMPLE below)

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
DEFAULT_DEMO_QUERY=Reply with exactly one short sentence confirming you work.

MODEL_TEMPERATURE=0.2
MAX_TOKENS=4096

# Optional $ per 1M tokens, for local cost estimates
# DEFAULT_INPUT_PRICE_PER_MILLION=0.30
# DEFAULT_OUTPUT_PRICE_PER_MILLION=1.20

# File toolkit sandbox (collect_tools(files=True)). Blank = skip file tools.
FILE_TOOLS_ROOT=
# MCP tools (collect_tools(mcp=True)), config in MCP_TOOLS inside llm_utils.py
MCP_ENABLED=false

# =============================================================================
# openai
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# =============================================================================
# anthropic (native class; also used by Claude models on opencode)
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# =============================================================================
# google
# =============================================================================
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# =============================================================================
# groq
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# =============================================================================
# openrouter  (base_url defaults to https://openrouter.ai/api/v1)
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# =============================================================================
# vercel AI gateway  (base_url defaults to https://ai-gateway.vercel.sh/v1)
# =============================================================================
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_MODEL=openai/gpt-4o

# =============================================================================
# opencode (pay-as-you-go) and opencode-go (subscription)
# base_urls default to https://opencode.ai/inference[/go]; model ids are bare.
# Cheap option: deepseek-v4.1-flash. Note: jev-1.13 is not a chat model.
# =============================================================================
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
# Stable session id sent to the gateway (default: one random id per model built)
# OPENCODE_SESSION_ID=

# =============================================================================
# Custom example — any OpenAI-compatible endpoint. The name below is yours:
# create_llm("kimi-k2", provider="acme") then needs no other arguments.
# =============================================================================
# ACME_API_KEY=
# ACME_MODEL=kimi-k2
# ACME_BASE_URL=https://acme.example/v1

# =============================================================================
# Knobs
# =============================================================================
# LLM_PREFER_IPV4=1   # IPv4 first; 0 to opt out (fixes hangs on broken-IPv6 WSL)
