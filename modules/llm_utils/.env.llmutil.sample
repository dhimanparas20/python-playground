# Sample env for llm_utils.py
# Copy:  cp .env.llmutil.sample .env
# Fill only the providers you use. Empty / commented values are ignored.

# =============================================================================
# Shared defaults
# =============================================================================
DEFAULT_PROVIDER=openai
# openai | google | openrouter | groq | vercel_ai_gateway

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
DEFAULT_DEMO_QUERY=Reply with exactly one short sentence confirming you work.

MODEL_TEMPERATURE=0.2
MAX_TOKENS=4096

# FileManagementToolkit sandbox (optional). Leave empty to skip file tools.
FILE_TOOLS_ROOT=./sandbox

# MCP tool loading (default: false)
MCP_ENABLED=false

# =============================================================================
# openai
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# =============================================================================
# google (Gemini)
# =============================================================================
GOOGLE_API_KEY=
# Fallback if GOOGLE_API_KEY is unset:
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# =============================================================================
# openrouter
# base_url is hardcoded in llm_utils.py (not read from env)
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# =============================================================================
# groq
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# =============================================================================
# vercel_ai_gateway
# base_url is hardcoded: https://ai-gateway.vercel.sh/v1
# Prefer AI_GATEWAY_API_KEY; VERCEL_OIDC_TOKEN works on Vercel deployments.
# =============================================================================
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_MODEL=openai/gpt-4o

# =============================================================================
# Optional MCP-related (only if you uncomment those servers in MCP_TOOLS)
# =============================================================================
DEFAULT_MCP_SERVER_URL=http://localhost:8000/mcp/
PAGE_INDEX_API_KEY=
FIRECRAWL_API_KEY=

# =============================================================================
# Pricing note
# =============================================================================
# input_price_per_million / output_price_per_million are NOT env vars.
# Pass them to create_llm / get_agent, or set in llm_utils.py:
#   DEFAULT_INPUT_PRICE_PER_MILLION = 2.50
#   DEFAULT_OUTPUT_PRICE_PER_MILLION = 10.00
